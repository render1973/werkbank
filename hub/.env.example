# Kopiere diese Datei zu ".env" und trage deinen echten API-Key ein.
# .env NIE ins Git-Repo committen.

ANTHROPIC_API_KEY=dein-api-key-hier

# Optional — Defaults sind für die meisten Fälle passend
CLAUDE_MODEL=claude-sonnet-4-6
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
